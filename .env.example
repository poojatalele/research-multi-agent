# Copy to .env and adjust if needed. Docker and start-n8n.sh load it.

# The workflow uses OpenRouter Chat Model credentials stored inside n8n.
# Create that credential in the n8n UI after importing the workflow.

# n8n config - leave as-is unless you know what you're changing
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_RUNNERS_ENABLED=true
N8N_SECURE_COOKIE=false
