# Copy to .env and fill in. The start script auto-loads it.

# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Semantic Scholar API key (unauthenticated works too, just rate-limited)
# Request at https://www.semanticscholar.org/product/api
S2_API_KEY=

# Optional: identify yourself to OpenAlex for the polite pool (faster, no rate limits)
OPENALEX_MAILTO=mr.mandartalele@gmail.com

# Optional: SerpAPI key if you want to enable the Google Scholar branch later
SERPAPI_KEY=

# n8n config — leave as-is unless you know what you're changing
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_RUNNERS_ENABLED=true
N8N_SECURE_COOKIE=false
